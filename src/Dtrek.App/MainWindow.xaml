<Window x:Class="Dtrek.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dtrek.App"
        Title="DTREK - Stage 5"
        Width="1280" Height="840"
        MinWidth="1040" MinHeight="700"
        Background="#080C13"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        Deactivated="OnDeactivated"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5E7A96" />
            <Setter Property="Margin" Value="0,14,0,3" />
        </Style>
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D6E2F0" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="332" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#060A10"
                BorderBrush="#1B2A3D"
                BorderThickness="1"
                CornerRadius="4">
            <local:GalaxyView x:Name="View" />
        </Border>

        <Border Grid.Column="1"
                Margin="14,0,0,0"
                Padding="16,14"
                Background="#0D1521"
                BorderBrush="#1B2A3D"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock Text="DTREK"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#66FFB2" />
                    <TextBlock Text="Stage 5 / subsystem damage"
                               FontSize="11"
                               Foreground="#63799A"
                               Margin="0,-2,0,10" />

                    <Border Background="#0A1A16"
                            BorderBrush="#1E4638"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,7">
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="PATROL"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#66FFB2" />
                            <TextBlock x:Name="ClockText"
                                       Text="T+00:00  tick 0"
                                       FontSize="11"
                                       Foreground="#7F95AD"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="SYSTEMS" />
                    <TextBlock x:Name="HullText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="ArmorText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="FuelText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="KillsText" Style="{StaticResource Readout}" />

                    <TextBlock Style="{StaticResource Section}" Text="DAMAGE CONTROL" />
                    <TextBlock x:Name="DamageSummaryText"
                               Style="{StaticResource Readout}" />
                    <StackPanel x:Name="DamagePanel" Margin="0,2,0,0" />
                    <TextBlock x:Name="DamageEmptyText"
                               FontSize="12"
                               Foreground="#66FFB2"
                               Margin="0,1,0,1"
                               Text="All systems nominal" />

                    <TextBlock Style="{StaticResource Section}" Text="SHIELDS" />
                    <TextBlock x:Name="ScreenText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="FrontShieldText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="RightShieldText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="RearShieldText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="LeftShieldText" Style="{StaticResource Readout}" />

                    <TextBlock Style="{StaticResource Section}" Text="HELM" />
                    <TextBlock x:Name="SpeedText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="CourseText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="BeamsText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="TubesText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="OrdnanceText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="LockText" Style="{StaticResource Readout}" />

                    <TextBlock Style="{StaticResource Section}" Text="NAVIGATION" />
                    <TextBlock x:Name="OrbitText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="PlanetText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="ServiceText" Style="{StaticResource Readout}" />

                    <TextBlock Style="{StaticResource Section}" Text="TARGET" />
                    <TextBlock x:Name="TargetNameText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="TargetRangeText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="TargetStatusText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="TargetShieldText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="TargetAiText" Style="{StaticResource Readout}" />
                    <TextBlock x:Name="ThreatText" Style="{StaticResource Readout}" />

                    <TextBlock Style="{StaticResource Section}" Text="LOG" />
                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource Readout}"
                               Foreground="#9FB3C8"
                               TextWrapping="Wrap"
                               LineHeight="16" />

                    <TextBlock Style="{StaticResource Section}" Text="CONTROLS" />
                    <TextBlock x:Name="ControlsText"
                               Style="{StaticResource Readout}"
                               Foreground="#6E849C"
                               TextWrapping="Wrap" />

                    <Border BorderBrush="#1B2A3D"
                            BorderThickness="0,1,0,0"
                            Margin="0,16,0,0"
                            Padding="0,8,0,0">
                        <TextBlock x:Name="EngineText"
                                   FontSize="10"
                                   Foreground="#4E6379"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
