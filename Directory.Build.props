<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DtrekVersion>0.6.0</DtrekVersion>
    <Version>$(DtrekVersion)</Version>
    <AssemblyVersion>$(DtrekVersion).0</AssemblyVersion>
    <FileVersion>$(DtrekVersion).0</FileVersion>
    <InformationalVersion>$(DtrekVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>DTREK Modern</Company>
    <Product>DTREK</Product>
    <Copyright>Copyright (c) 1986 Chris Guthrie; major overhaul 1989 Daryl Poe; Windows conversion 2026.</Copyright>
    <DtrekNativeArtifact>$(MSBuildThisFileDirectory)artifacts\native\dtrek_core.dll</DtrekNativeArtifact>
  </PropertyGroup>

  <!--
    The native core is built first by scripts/build.ps1.  Every managed
    project gets a copy beside its executable so DllImport("dtrek_core")
    works both under dotnet run and when launched directly.
  -->
  <ItemGroup Condition="Exists('$(DtrekNativeArtifact)')">
    <None Include="$(DtrekNativeArtifact)">
      <Link>dtrek_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
